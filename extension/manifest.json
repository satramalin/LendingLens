{
  "manifest_version": 3,
  "name": "LendingLens",
  "description": "AI-powered mortgage data explorer using Phi mini to query FFIEC HMDA data and visualize insights.",
  "version": "0.1.0",
  "action": {
    "default_title": "LendingLens"
  },
  "permissions": [
    "storage",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "https://api.consumerfinance.gov/*",
    "https://*.azure.com/*",
    "https://*.azureai.azure.com/*",
    "https://ffiec.cfpb.gov/*",
    "https://cdn.jsdelivr.net/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["vendor/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {}
}